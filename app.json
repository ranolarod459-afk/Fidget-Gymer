{
  "expo": {
    "name": "Fidget Gymer",
    "slug": "fidget-gymer",
    "version": "1.0.0",
    "orientation": "portrait",
    "plugins": [
      "expo-notifications",
      "expo-dev-client",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101410",
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "androidStatusBar": {
      "backgroundColor": "#020617",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101410",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rodran.fidgetgymer"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "5dd945b2-8408-41dc-96b7-f8f85b2229c0"
      }
    },
    "owner": "rodran"
  }
}
